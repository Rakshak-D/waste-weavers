# Database
# Configure a real PostgreSQL database before running migrations, seed, or integration tests.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/waste_weavers?schema=public"
PAYMENT_MODE="development"
# Set to failed only for local payment-failure testing; never use this as a production payment control.
DEV_PAYMENT_OUTCOME="success"

# Authentication (Auth.js Credentials + managed JWT session)
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
# Generate a secret locally with: npx auth secret

# Future production payment provider secrets (not used by the development adapter)
PAYMENT_PROVIDER_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# Optional application settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"

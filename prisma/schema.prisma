generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderType {
  PURCHASE
  RENTAL
  MIXED
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  FULFILLING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  AUTHORIZED
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum OrderItemType {
  PURCHASE
  RENTAL
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  RENTED
  RETURN_PENDING
  INSPECTION
  MAINTENANCE
  DAMAGED
  RETIRED
}

enum InventoryCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
}

enum RentalStatus {
  PENDING
  RESERVED
  ACTIVE
  RETURN_PENDING
  COMPLETED
  CANCELLED
}

enum ReturnStatus {
  EXPECTED
  RECEIVED
  INSPECTION_REQUIRED
  PROCESSED
  CANCELLED
}

enum ReturnCondition {
  NOT_ASSESSED
  GOOD
  NEEDS_MAINTENANCE
  DAMAGED
  RETIRED
}

enum MaintenanceType {
  INSPECTION
  CLEANING
  REPAIR
  REFURBISHMENT
}

enum MaintenanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CustomOrderStatus {
  REQUESTED
  UNDER_REVIEW
  QUOTED
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id           String        @id @default(cuid())
  name         String?
  email        String        @unique
  phone        String?
  passwordHash String?
  role         UserRole      @default(CUSTOMER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  addresses    Address[]
  orders       Order[]
  rentals      Rental[]
  customOrders CustomOrder[]
  cart         Cart?

  @@index([role])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id                  String          @id @default(cuid())
  name                String
  slug                String          @unique
  shortDescription    String?
  description         String
  purchasePrice       Decimal?        @db.Decimal(12, 2)
  currency            String          @default("INR") @db.VarChar(3)
  rentalPricingConfig Json?
  rentalPricingNotes  String?
  rentable            Boolean         @default(false)
  purchasable         Boolean         @default(false)
  status              ProductStatus   @default(DRAFT)
  material            String?
  dimensions          String?
  weight              Decimal?        @db.Decimal(10, 3)
  color               String?
  categoryId          String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  category            Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images              ProductImage[]
  inventoryUnits      InventoryUnit[]
  impactMetrics       ImpactMetric[]
  orderItems          OrderItem[]
  cartItems           CartItem[]

  @@index([categoryId, status])
  @@index([status, rentable, purchasable])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String        @id @default(cuid())
  cartId    String
  productId String
  itemType  OrderItemType
  quantity  Int
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  cart      Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([cartId, createdAt])
  @@index([productId, itemType])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model InventoryUnit {
  id                 String              @id @default(cuid())
  productId          String
  inventoryCode      String              @unique
  status             InventoryStatus     @default(AVAILABLE)
  condition          InventoryCondition  @default(NEW)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  product            Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  rentalAllocations  RentalAllocation[]
  maintenanceRecords MaintenanceRecord[]

  @@index([productId, status])
  @@index([status, condition])
}

model Order {
  id                      String        @id @default(cuid())
  orderNumber             String        @unique
  customerId              String
  type                    OrderType
  status                  OrderStatus   @default(DRAFT)
  paymentStatus           PaymentStatus @default(PENDING)
  currency                String        @default("INR") @db.VarChar(3)
  subtotal                Decimal?      @db.Decimal(12, 2)
  discountTotal           Decimal?      @db.Decimal(12, 2)
  taxTotal                Decimal?      @db.Decimal(12, 2)
  deliveryTotal           Decimal?      @db.Decimal(12, 2)
  grandTotal              Decimal?      @db.Decimal(12, 2)
  shippingAddressSnapshot Json?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  customer                User          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items                   OrderItem[]
  rentals                 Rental[]

  @@index([customerId, createdAt])
  @@index([status, paymentStatus])
}

model OrderItem {
  id                    String        @id @default(cuid())
  orderId               String
  productId             String
  itemType              OrderItemType
  quantity              Int
  currency              String        @default("INR") @db.VarChar(3)
  unitPrice             Decimal       @db.Decimal(12, 2)
  lineTotal             Decimal       @db.Decimal(12, 2)
  rentalPricingSnapshot Json?
  impactSnapshot        Json?
  createdAt             DateTime      @default(now())
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product               Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId, itemType])
}

model Rental {
  id                    String             @id @default(cuid())
  orderId               String?
  customerId            String
  startAt               DateTime
  endAt                 DateTime
  status                RentalStatus       @default(PENDING)
  currency              String             @default("INR") @db.VarChar(3)
  pricingSnapshot       Json?
  deliveryScheduledAt   DateTime?
  deliveredAt           DateTime?
  collectionScheduledAt DateTime?
  collectedAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  order                 Order?             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer              User               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  allocations           RentalAllocation[]
  return                RentalReturn?

  @@index([orderId, createdAt])
  @@index([customerId, createdAt])
  @@index([status, startAt, endAt])
  @@index([startAt, endAt])
}

model RentalAllocation {
  id                String             @id @default(cuid())
  rentalId          String
  inventoryUnitId   String
  allocatedAt       DateTime           @default(now())
  releasedAt        DateTime?
  rental            Rental             @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  inventoryUnit     InventoryUnit      @relation(fields: [inventoryUnitId], references: [id], onDelete: Restrict)
  returnInspections ReturnInspection[]

  @@unique([rentalId, inventoryUnitId])
  @@index([inventoryUnitId, rentalId])
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  label         String?
  recipientName String?
  line1         String
  line2         String?
  city          String
  state         String
  postalCode    String
  country       String   @default("IN") @db.VarChar(2)
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model RentalReturn {
  id          String             @id @default(cuid())
  rentalId    String             @unique
  returnedAt  DateTime?
  receivedAt  DateTime?
  status      ReturnStatus       @default(EXPECTED)
  condition   ReturnCondition    @default(NOT_ASSESSED)
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  rental      Rental             @relation(fields: [rentalId], references: [id], onDelete: Restrict)
  inspections ReturnInspection[]

  @@index([status, receivedAt])
}

model ReturnInspection {
  id                 String           @id @default(cuid())
  rentalReturnId     String
  rentalAllocationId String           @unique
  condition          ReturnCondition  @default(NOT_ASSESSED)
  maintenanceType    MaintenanceType?
  notes              String?
  inspectedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  rentalReturn       RentalReturn     @relation(fields: [rentalReturnId], references: [id], onDelete: Cascade)
  rentalAllocation   RentalAllocation @relation(fields: [rentalAllocationId], references: [id], onDelete: Restrict)

  @@index([rentalReturnId, condition])
  @@index([condition, inspectedAt])
}

model MaintenanceRecord {
  id              String            @id @default(cuid())
  inventoryUnitId String
  type            MaintenanceType
  status          MaintenanceStatus @default(PENDING)
  description     String?
  startedAt       DateTime?
  completedAt     DateTime?
  cost            Decimal?          @db.Decimal(12, 2)
  currency        String            @default("INR") @db.VarChar(3)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  inventoryUnit   InventoryUnit     @relation(fields: [inventoryUnitId], references: [id], onDelete: Restrict)

  @@index([inventoryUnitId, createdAt])
  @@index([status, type])
}

model CustomOrder {
  id               String            @id @default(cuid())
  customerId       String
  eventType        String
  eventDate        DateTime?
  guestCount       Int?
  requirements     String
  budget           Decimal?          @db.Decimal(12, 2)
  currency         String            @default("INR") @db.VarChar(3)
  referenceFileUrl String?
  status           CustomOrderStatus @default(REQUESTED)
  adminNotes       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  customer         User              @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([status, eventDate])
}

model ImpactMetric {
  id          String   @id @default(cuid())
  productId   String
  metricType  String
  value       Decimal  @db.Decimal(12, 3)
  unit        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, metricType])
}
